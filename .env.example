# ─────────────────────────────────────────────────────────────────────────────
#  Legal Video Analyzer — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: Your Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Flask secret key — change this to a random string for security
SECRET_KEY=change-this-to-a-random-secret-string

# Server settings (default: local only on port 5000)
HOST=127.0.0.1
PORT=5000
DEBUG=false

# Video analysis settings
# How many seconds between frame extractions (lower = more thorough, higher API cost)
VIDEO_FRAME_INTERVAL=5
# Max frames sent per API batch
FRAMES_PER_BATCH=4
# Max image dimension for frames (reduces API image token costs)
MAX_FRAME_SIZE=1024

# Claude model (claude-opus-4-6 is most capable; claude-haiku-4-5-20251001 is faster/cheaper)
CLAUDE_MODEL=claude-opus-4-6
